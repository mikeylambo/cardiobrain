{
  "name": "cardiobrain",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run lint && npm run test && node scripts/check-contrast.mjs && vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test e2e/smoke.spec.ts e2e/flows.spec.ts e2e/review.spec.ts",
    "e2e:long": "playwright test e2e/long.spec.ts",
    "contrast": "node scripts/check-contrast.mjs",
    "icons": "node scripts/build-icons.mjs",
    "screens": "playwright test e2e/screens.spec.ts --project iphone-14",
    "cap:sync": "npm run build && cap sync",
    "store:screens": "playwright test e2e/store.spec.ts --project iphone-14"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "idb-keyval": "^6.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^3.2.4"
  }
}
